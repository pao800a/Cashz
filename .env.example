# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it contains banking credentials.

# ── bunq ──────────────────────────────────────────────────────────────────────
# Generate in the bunq app: Profile → Security & Settings → Developers → API keys
BUNQ_API_KEY=

# "PRODUCTION" or "SANDBOX". Use SANDBOX for local testing (no real bunq account needed).
BUNQ_ENV=PRODUCTION

# "true" to create a wildcard IP key (works from any IP). Leave "false" for the safer
# standard key (locked to the device IP where the key was first registered).
BUNQ_ALLOW_ALL_IPS=false

# ── IBKR Flex Web Service ─────────────────────────────────────────────────────
# Generate in Client Portal: Performance & Reports → Flex Queries → Flex Web Service Configuration
IBKR_FLEX_TOKEN=
# The numeric ID shown in the (i) pop-over next to your Activity Flex Query
IBKR_FLEX_QUERY_ID=

# ── App ───────────────────────────────────────────────────────────────────────
# Where to store the SQLite database (absolute or relative to the repo root).
# This path is gitignored together with the whole data/ directory.
CASHZ_DB_PATH=data/cashz.db
